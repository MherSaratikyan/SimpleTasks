# Copy to .env for Docker Compose. Never commit .env.

# Use at least 12 characters with uppercase, lowercase, digits, and symbols.
# Avoid semicolons and double quotes because the password is inserted in a connection string.
MSSQL_SA_PASSWORD=ReplaceMe_WithYourOwnPassword123!

# Any long random strings. Use letters and digits only.
RABBITMQ_PASSWORD=ReplaceWithALongRandomString
INTERNAL_API_KEY=ReplaceWithAnotherLongRandomString

# The first Site Admin. They get a link to set their password on first start.
FIRST_ADMIN_EMAIL=you@gmail.com

# Sends invites, password resets and reminders. See docs/setup-email.md.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
