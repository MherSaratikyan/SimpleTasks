# Build the existing ASP.NET Core project with its .NET runtime included.
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY SimpleTasks/ SimpleTasks/
RUN dotnet publish SimpleTasks/SimpleTasks.csproj \
    -c Release -r linux-x64 --self-contained true \
    -p:UseAppHost=true -o /publish

# The final image contains both SQL Server and the published application.
FROM mcr.microsoft.com/mssql/server:2025-latest
USER root
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
       ca-certificates curl libbrotli1 libgssapi-krb5-2 libicu-dev libssl-dev tzdata zlib1g \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build --chown=mssql:root /publish/ ./
COPY --chown=mssql:root start-single-image.sh /app/start-single-image.sh
# Handle Windows line endings if the script was edited before building.
RUN sed -i 's/\r$//' /app/start-single-image.sh \
    && chmod 755 /app/start-single-image.sh
ENV ASPNETCORE_HTTP_PORTS=8080 \
    ASPNETCORE_ENVIRONMENT=Production \
    MSSQL_PID=Developer \
    SIMPLETASKS_DATABASE=SimpleTasks
EXPOSE 8080
VOLUME ["/var/opt/mssql"]
USER mssql
HEALTHCHECK --interval=30s --timeout=5s --start-period=120s --retries=3 \
    CMD curl -fsS http://127.0.0.1:8080/ > /dev/null || exit 1
ENTRYPOINT ["/bin/bash", "/app/start-single-image.sh"]
