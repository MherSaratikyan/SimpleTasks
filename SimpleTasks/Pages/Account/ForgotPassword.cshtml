@page
@model SimpleTasks.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = "Reset your password";
    ViewData["AuthPage"] = true;
}

<div class="login-card">
    <h1>Reset your password</h1>
    @if (Model.Sent)
    {
        <p role="status">If that email has an account, we've sent it a link to set a new password. The link works for 1 hour.</p>
        <p><a href="/Account/Login">Back to log in</a></p>
    }
    else
    {
        <p>Enter your email and we'll send you a link to set a new password.</p>
        <form method="post" class="stack">
            <label>Email
                <input name="email" type="email" required autocomplete="username" autofocus />
            </label>
            <button class="button primary" type="submit">Send link</button>
        </form>
        <p><a href="/Account/Login">Back to log in</a></p>
    }
</div>
