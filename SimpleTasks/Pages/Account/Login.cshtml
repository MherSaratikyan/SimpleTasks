@page
@model SimpleTasks.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Log in";
}

<div class="login-card">
    <h1>Log in to Simple Tasks</h1>

    @if (Model.Error is not null)
    {
        <p class="toast toast-error" role="alert">@Model.Error</p>
    }

    <form method="post" class="stack">
        <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
        <label>Email
            <input name="email" type="email" value="@Model.Email" required autocomplete="username" autofocus />
        </label>
        <label>Password
            <input name="password" type="password" required autocomplete="current-password" />
        </label>
        <button class="button primary" type="submit">Log in</button>
    </form>
    <p><a href="/Account/ForgotPassword">Forgot your password?</a></p>
    <p class="hint">Simple Tasks is invite only. Your invite email has a link to set your password.</p>

    @if (Model.DevUsers.Count > 0)
    {
        <hr />
        <h2>Development sign-in</h2>
        <p class="hint">Only available in the Development environment.</p>
        @foreach (var user in Model.DevUsers)
        {
            <form method="post" asp-page-handler="Dev">
                <input type="hidden" name="email" value="@user.Email" />
                <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                <button class="button" type="submit">@user.Email @(user.IsSiteAdmin ? "(Site Admin)" : "")</button>
            </form>
        }
    }
</div>
