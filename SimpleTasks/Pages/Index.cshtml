@page
@model IndexModel
@{
    ViewData["Title"] = "Your work";
}

<div class="page-title"><h1>Your work</h1></div>

@if (Model.Tickets.Count == 0)
{
    <div class="empty">
        <span class="empty-icon">@Ui.Icon("inbox")</span>
        <h2>Nothing assigned to you</h2>
        <p>Tickets assigned to you will appear here. <a href="/projects">Browse your projects</a>.</p>
    </div>
}
else
{
    <div class="table-card"><table class="issue-table">
        <thead>
            <tr><th>Type</th><th>Key</th><th>Summary</th><th>Status</th><th>Priority</th><th>Due</th></tr>
        </thead>
        <tbody>
            @foreach (var ticket in Model.Tickets)
            {
                <tr>
                    <td><partial name="_TypeIcon" model="ticket.Type" /></td>
                    <td><a class="key-link" href="/tickets/@ticket.Key">@ticket.Key</a></td>
                    <td>@ticket.Title</td>
                    <td><span class="lozenge @ticket.Status.Css()">@ticket.Status.Name()</span></td>
                    <td><partial name="_PriorityIcon" model="ticket.Priority" /></td>
                    <td class="@(ticket.DueAt < DateTime.UtcNow ? "overdue" : "")">@(ticket.DueAt is { } due ? Time.ShowDate(due) : "")</td>
                </tr>
            }
        </tbody>
    </table></div>
}
