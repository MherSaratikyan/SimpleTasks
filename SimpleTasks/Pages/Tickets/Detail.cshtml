@page "/tickets/{key}"
@model SimpleTasks.Pages.Tickets.DetailModel
@{
    var ticket = Model.Ticket;
    var card = ticket.Card;
    ViewData["Title"] = $"{card.Key} {card.Title}";
    if (Model.Panel)
    {
        Layout = null;
    }
    var canEdit = ticket.Role >= ProjectRole.Member && card.DeletedAt is null;
    var canAdminister = ticket.Role == ProjectRole.Admin;
    var fields = new SimpleTasks.Pages.Tickets.TicketFieldsView(card.Title, ticket.Description, card.Type, card.Priority, card.Assignee?.Id,
        card.Estimate, card.DueAt, card.Labels.Select(label => label.Id).ToList(), Model.Members, Model.Labels, card.QaOwner?.Id);
    var panelArg = Model.Panel ? "?panel=true" : "";
    string Post(string handler) => $"/tickets/{card.Key}?handler={handler}{(Model.Panel ? "&panel=true" : "")}";
}

<div class="ticket">
    @if (Model.Panel)
    {
        <partial name="_Toasts" model="Model" />
        <button type="button" class="icon-button panel-close" aria-label="Close">@Ui.Icon("x")</button>
    }
    <p class="crumbs">
        <a href="/projects/@ticket.ProjectKey/board">@ticket.ProjectName</a> /
        <partial name="_TypeIcon" model="card.Type" />
        <a href="/tickets/@card.Key">@card.Key</a>
    </p>
    <h1>@card.Title</h1>

    @if (card.DeletedAt is not null)
    {
        <p class="notice">This ticket was deleted. Restore it from project settings.</p>
    }

    <div class="ticket-layout">
        <div class="ticket-main">
            <section class="section-card">
            <form method="post" asp-antiforgery="true" class="stack" action="@Post("Save")" hx-post="@Post("Save")" hx-target="#panel" hx-disable="@(!Model.Panel)">
                <fieldset disabled="@(!canEdit)" class="plain">
                    <label>Status
                        <select name="Status" class="status-select">
                            @foreach (var status in Ui.Statuses)
                            {
                                <option value="@status" selected="@(status == card.Status)">@status.Name()</option>
                            }
                        </select>
                    </label>
                    <partial name="_TicketFields" model="fields" />
                    @if (canEdit)
                    {
                        <button class="button primary" type="submit">Save changes</button>
                    }
                </fieldset>
            </form>
            </section>

            <section class="section-card">
            <h2>@Ui.Icon("message-square") Comments</h2>
            @if (ticket.Comments.Count == 0)
            {
                <p class="hint">No comments yet.</p>
            }
            @foreach (var comment in ticket.Comments)
            {
                <div class="comment">
                    <partial name="_Avatar" model="comment.Author" />
                    <div>
                        <p class="comment-head"><strong>@(comment.Author?.DisplayName ?? "Unknown user")</strong> <small>@Time.Show(comment.CreatedAt)</small></p>
                        <p class="comment-body">@comment.Body</p>
                    </div>
                </div>
            }
            @if (canEdit)
            {
                <form method="post" asp-antiforgery="true" class="stack" action="@Post("Comment")" hx-post="@Post("Comment")" hx-target="#panel" hx-disable="@(!Model.Panel)">
                    <label>Add a comment
                        <textarea name="body" rows="3" required maxlength="10000"></textarea>
                    </label>
                    <button class="button" type="submit">Comment</button>
                </form>
            }
            </section>

            <section class="section-card">
            <h2>@Ui.Icon("clock") History</h2>
            <ul class="activity">
                @foreach (var entry in ticket.Activity)
                {
                    <li>
                        <strong>@(entry.Actor?.DisplayName ?? "System")</strong> @(entry.Kind == 2 ? "changed the status" : entry.Text)
                        @if (entry.To is not null && entry.Kind != 1)
                        {
                            <span class="change">
                                @if (entry.From is not null)
                                {
                                    <span class="change-from">@entry.From</span>
                                    <span aria-label="to">&rarr;</span>
                                }
                                <span class="change-to">@entry.To</span>
                            </span>
                        }
                        <small>@Time.Show(entry.CreatedAt)</small>
                    </li>
                }
            </ul>
            </section>
        </div>

        <aside class="ticket-side">
            <section class="section-card">
            <h2>@Ui.Icon("timer") Time tracking</h2>
            @if (card.EstimateMinutes is null)
            {
                <p class="chip chip-warn">No estimate</p>
            }
            else
            {
                <div class="progress @(card.LoggedMinutes > card.EstimateMinutes ? "progress-over" : "")" role="img" aria-label="@Ui.PercentUsed(card)% of estimate used">
                    <span style="width:@Ui.PercentUsed(card)%"></span>
                </div>
            }
            <p>@card.Logged logged@(card.Estimate is null ? "" : $" of {card.Estimate}")</p>
            @if (canEdit)
            {
                <form method="post" asp-antiforgery="true" class="stack" action="@Post("LogWork")" hx-post="@Post("LogWork")" hx-target="#panel" hx-disable="@(!Model.Panel)">
                    <label>Log time
                        <input name="time" required placeholder="45m, 2h" />
                    </label>
                    <label>Note
                        <input name="note" maxlength="500" />
                    </label>
                    <button class="button" type="submit">Log work</button>
                </form>
            }
            @if (ticket.WorkLogs.Count > 0)
            {
                <ul class="activity">
                    @foreach (var log in ticket.WorkLogs)
                    {
                        <li><strong>@log.Time</strong> by @(log.User?.DisplayName ?? "Unknown user")@(log.Note is null ? "" : $": {log.Note}") <small>@Time.ShowDate(log.CreatedAt)</small></li>
                    }
                </ul>
            }
            </section>

            @if (card.DeletedAt is null)
            {
                <section class="section-card">
                <h2>@Ui.Icon("alarm-clock") Remind me</h2>
                @foreach (var reminder in Model.Reminders)
                {
                    <form method="post" asp-antiforgery="true" class="reminder" action="@Post("DeleteReminder")" hx-post="@Post("DeleteReminder")" hx-target="#panel" hx-disable="@(!Model.Panel)">
                        <input type="hidden" name="id" value="@reminder.Id" />
                        <span>@Time.Show(reminder.RemindAt)@(reminder.Note is null ? "" : $": {reminder.Note}")</span>
                        <button class="link-button" type="submit">Cancel</button>
                    </form>
                }
                <form method="post" asp-antiforgery="true" class="stack" action="@Post("Reminder")" hx-post="@Post("Reminder")" hx-target="#panel" hx-disable="@(!Model.Panel)">
                    <label>When
                        <input name="remindAt" type="datetime-local" required />
                    </label>
                    <label>Note
                        <input name="note" maxlength="500" />
                    </label>
                    <button class="button" type="submit">Set reminder</button>
                </form>
                </section>
            }

            <section class="section-card">
            <h2>@Ui.Icon("tag") Details</h2>
            <dl class="details">
                <dt>Created by</dt><dd>@(ticket.Reporter?.DisplayName ?? "Imported")</dd>
                <dt>Creation time</dt><dd>@Time.Show(ticket.CreatedAt)</dd>
                <dt>Assignee</dt><dd>@(card.Assignee?.DisplayName ?? "Unassigned")</dd>
                @if (card.Assignee is not null)
                {
                    <dt>Assigned by</dt>
                    <dd>@(ticket.AssignedBy?.DisplayName ?? "Unknown")@(ticket.AssignedAt is { } assignedAt ? $", {Time.Show(assignedAt)}" : "")</dd>
                }
                <dt>QA owner</dt><dd>@(card.QaOwner?.DisplayName ?? "None")</dd>
                @if (card.Status == TicketStatus.Done)
                {
                    <dt>Done by</dt><dd>@(ticket.CompletedBy?.DisplayName ?? "Unknown")</dd>
                    <dt>Completion time</dt><dd>@(ticket.CompletedAt is { } completedAt ? Time.Show(completedAt) : "Unknown")</dd>
                }
                <dt>Updated</dt><dd>@Time.Show(ticket.UpdatedAt)</dd>
            </dl>

            @if (canAdminister && card.DeletedAt is null)
            {
                <form method="post" asp-antiforgery="true" action="/tickets/@card.Key?handler=Delete" style="margin-top:16px">
                    <button class="button button-danger" type="submit">@Ui.Icon("trash-2") Delete ticket</button>
                </form>
            }
            </section>
        </aside>
    </div>
</div>
